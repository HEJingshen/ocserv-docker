# 🌐 统一 HTTPS 入口
# 此文件由 docker-entrypoint.sh 自动生成，请勿直接编辑
# 模板文件: nginx/templates/monitoring-subpath.conf.template

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    # 全局安全响应头
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 📊 Grafana 子路径代理
    location /grafana/ {
        # 注意：末尾斜杠必须保留，确保路径完整透传
        proxy_pass http://grafana:3000/grafana/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支持（Grafana Live / 告警推送必需）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 📈 Prometheus 子路径代理（带基础认证）
    location /prometheus/ {
        auth_basic "Prometheus Access Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://prometheus:9090/prometheus/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 🚫 拦截 Prometheus 高危管理 API（外部不可访问）
    location ~ ^/prometheus/api/v1/admin {
        deny all;
        return 403;
    }

    # 根路径默认跳转
    location / {
        return 302 /grafana/;
    }
}