@@ -241,7 +241,41 @@
 int get_ca_der_handler(worker_st *ws, unsigned int http_ver)
 {
 	return ca_handler(ws, http_ver, 1);
+}
+
+#ifdef HAVE_SAML
+int get_saml_metadata_handler(worker_st *ws, unsigned int http_ver)
+{
+	int ret;
+	struct stat st;
+	const char *metadata_path = "/run/ocserv/spmeta.xml";
+
+	oclog(ws, LOG_HTTP_DEBUG, "requested saml sp metadata: %s",
+	      ws->req.url);
+
+	ret = stat(metadata_path, &st);
+	if (ret == -1) {
+		oclog(ws, LOG_INFO,
+		      "cannot load metadata xml file %s", metadata_path);
+		response_404(ws, http_ver);
+		return -1;
+	}
+
+	cstp_cork(ws);
+	if (send_headers(ws, http_ver, "text/xml", (unsigned)st.st_size) < 0 ||
+	    cstp_uncork(ws) < 0)
+		return -1;
+
+	ret = cstp_send_file(ws, metadata_path);
+	if (ret < 0) {
+		oclog(ws, LOG_ERR, "error sending file '%s'",
+		      metadata_path);
+		return -1;
+	}
+
+	return 0;
 }
+#endif
 
