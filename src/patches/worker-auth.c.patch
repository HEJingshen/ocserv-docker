+int send_saml_request_redirect(worker_st *ws, unsigned int http_ver,
+			       const char *pmsg, unsigned int pcounter)
+{
+	char context[BASE64_ENCODE_RAW_LENGTH(SID_SIZE) + 1];
+	int ret;
+
+	oclog(ws, LOG_HTTP_DEBUG,
+	      "HTTP sending: 303 See Other (SAML redirect)");
+	cstp_cork(ws);
+	ret = cstp_printf(ws, "HTTP/1.%u 303 See Other\r\n", http_ver);
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Content-Type: text/html; charset=utf-8\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Content-Length: 0\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Cache-Control: no-store\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Pragma: no-cache\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Connection: Keep-Alive\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws,
+			"Set-Cookie: webvpncontext=; expires=Thu, 01 Jan 1970 22:00:00 GMT; path=/; Secure\r\n");
+	if (ret < 0)
+		return -1;
+
+	if (ws->sid_set != 0) {
+		char safe_id[SAFE_ID_SIZE];
+
+		oc_base64_encode((char *)ws->sid, sizeof(ws->sid),
+				 (char *)context, sizeof(context));
+
+		ret = cstp_printf(ws,
+				  "Set-Cookie: webvpncontext=%s; Max-Age=%lu; Secure; HttpOnly\r\n",
+				  context,
+				  (unsigned long)WSCONFIG(ws)->cookie_timeout);
+		if (ret < 0)
+			return -1;
+
+		oclog(ws, LOG_SENSITIVE, "sent session id: %s",
+		      calc_safe_id(ws->sid, sizeof(ws->sid), safe_id,
+				   sizeof(safe_id)));
+	} else {
+		ret = cstp_puts(ws,
+				"Set-Cookie: webvpncontext=; expires=Thu, 01 Jan 1970 22:00:00 GMT; path=/; Secure; HttpOnly\r\n");
+		if (ret < 0)
+			return -1;
+	}
+
+	ret = cstp_printf(ws, "Location: %s\r\n", pmsg);
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Set-Cookie: acsamlcap=v2; path=/; secure\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "Set-Cookie: tg=; path=/; secure\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws,
+			"Set-Cookie: acSamlv2Error=; path=/; secure\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_puts(ws, "\r\n");
+	if (ret < 0)
+		return -1;
+
+	ret = cstp_uncork(ws);
+	if (ret < 0)
+		return -1;
+
+	return 0;
+}
+
+int post_acs_handler(worker_st *ws, unsigned int http_ver)
+{
+	int ret;
+	str_st str;
+	char context[BASE64_ENCODE_RAW_LENGTH(SID_SIZE) + 1];
+	char *saml_response_start;
+	char *unescaped_saml_response = NULL;
+
+	memset(context, 0, sizeof(context));
+	str_init(&str, ws);
+
+	if (ws->req.body == NULL || ws->req.body_length == 0) {
+		oclog(ws, LOG_ERR, "SAML ACS: empty POST body");
+		ret = -1;
+		goto cleanup;
+	}
+
+	saml_response_start = strstr(ws->req.body, "SAMLResponse=");
+	if (saml_response_start == NULL) {
+		oclog(ws, LOG_ERR, "SAML ACS: no SAMLResponse in POST body");
+		ret = -1;
+		goto cleanup;
+	}
+	saml_response_start += 13;
+
+	{
+		unsigned int len = 0;
+		while (saml_response_start[len] != 0 &&
+		       saml_response_start[len] != '&')
+			len++;
+
+		if (len > 0) {
+			unescaped_saml_response =
+				unescape_url(ws->req.body, saml_response_start,
+					     len, NULL);
+		}
+	}
+
+	if (unescaped_saml_response == NULL) {
+		oclog(ws, LOG_ERR, "SAML ACS: failed to decode SAMLResponse");
+		ret = -1;
+		goto cleanup;
+	}
+
+	oclog(ws, LOG_HTTP_DEBUG, "HTTP sending: 200 OK (ACS bridge)");
+	cstp_cork(ws);
+	ret = cstp_printf(ws, "HTTP/1.%u 200 OK\r\n", http_ver);
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = cstp_puts(ws, "Content-Type: text/html; charset=utf-8\r\n");
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	if (ws->sid_set != 0) {
+		oc_base64_encode((char *)ws->sid, sizeof(ws->sid),
+				 (char *)context, sizeof(context));
+
+		ret = cstp_printf(ws,
+				  "Set-Cookie: webvpncontext=%s; Max-Age=%lu; Secure; HttpOnly\r\n",
+				  context,
+				  (unsigned long)WSCONFIG(ws)->cookie_timeout);
+		if (ret < 0) {
+			ret = -1;
+			goto cleanup;
+		}
+	}
+
+	ret = cstp_puts(ws, "Cache-Control: no-store\r\n");
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = str_append_printf(&str, ACS_RESPONSE_FORM,
+				context,
+				(unsigned)WSCONFIG(ws)->cookie_timeout,
+				unescaped_saml_response);
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = cstp_printf(ws, "Content-Length: %u\r\n",
+			  (unsigned int)str.length);
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = cstp_puts(ws, "\r\n");
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = cstp_send(ws, str.data, str.length);
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = cstp_uncork(ws);
+	if (ret < 0) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = 0;
+
+ cleanup:
+	if (unescaped_saml_response != NULL)
+		talloc_free(unescaped_saml_response);
+	str_clear(&str);
+	return ret;
 }
 
