# ============================================
# ocserv-docker environment template
# ============================================
# Usage:
# 1. Run ./scripts/prepare-ocserv-config.sh.
# 2. The script opens vi .env; replace DOMAIN and GF_ADMIN_PASSWORD before production use.
# 3. If you edit .env later, run ./scripts/render-ocserv-conf.sh again.

# Base ocserv deployment
TZ=Asia/Shanghai
DOMAIN=your.domain.com
OCSERV_PORT=443
OCSERV_IMAGE=kingsonho/ocserv:latest
OCSERV_DISABLE_UTMP=false
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=15s

# Optional monitoring stack
MONITORING_PORT=8443
NETWORK_NAME=monitor-net
EXPORTER_IMAGE=kingsonho/ocserv-exporter:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NGINX_IMAGE=nginx:alpine
GF_ADMIN_PASSWORD=change-me-before-production
GF_ALLOW_SIGN_UP=false
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=30s
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=false
GF_DATAPROXY_RESPONSE_LIMIT=10485760
GRAFANA_MEM_LIMIT=512m
GRAFANA_MEMSWAP_LIMIT=512m
GRAFANA_CPUS=1.00

# Exporter collection settings
METRICS_PORT=9100
EXPORTER_INTERVAL_SECONDS=10
OCCTL_TIMEOUT_SECONDS=2
EXPORTER_ENABLE_SESSION_DETAIL_METRICS=false

SSL_CERT_DIR=/etc/letsencrypt
