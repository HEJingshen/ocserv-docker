# ============================================
# ocserv-docker environment template
# ============================================
# Usage:
# 1. Run ./scripts/prepare-ocserv-config.sh for ocserv only.
# 2. The script opens vi .env; replace DOMAIN before production use.
# 3. If you edit .env later, run ./scripts/render-ocserv-conf.sh again.

# Base ocserv deployment
TZ=Asia/Shanghai
DOMAIN=your.domain.com
OCSERV_PORT=443
OCSERV_VERSION=1.4.2
# Optional full image overrides for custom registries or local builds.
# OCSERV_IMAGE=kingsonho/ocserv:${OCSERV_VERSION}
# OCSERV_AUTH_IMAGE=kingsonho/ocserv-auth:${OCSERV_VERSION}
OCSERV_ENABLE_CERT_AUTH=false
OCSERV_ENABLE_COMPRESSION=false
OCSERV_NO_UDP=false
OCSERV_MAX_CLIENTS=32
OCSERV_MEM_LIMIT=512m
OCSERV_MEMSWAP_LIMIT=512m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=15s

# Certificate auth tooling
ALLOW_EMPTY_P12_PASSWORD=true
P12_EXPORT_PASSWORD=

# SAML authentication configuration (requires ocserv-saml image variant)
# Set to true and configure SAML metadata files to enable SAML 2.0 authentication
OCSERV_ENABLE_SAML_AUTH=false
OCSERV_SAML_CONFIG_PATH=/etc/ocserv/saml/config.ini
# Server hostname for SAML SSO-v2 redirect URLs (external FQDN, e.g. vpn.example.com).
# Falls back to DOMAIN if empty.
OCSERV_HOSTNAME=
