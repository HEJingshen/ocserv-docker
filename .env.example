# ============================================
# ocserv-docker 环境变量配置模板
# ============================================
# 使用方法:
# 1. 仅部署 ocserv:
#    cp .env.example .env && docker-compose up -d
#
# 2. 附加监控面板 (Prometheus + Grafana + Nginx):
#    cp .env.example .env && docker-compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
#
# 请将 your.domain.com 替换为您的实际域名

# ============ 基础部署配置 (docker-compose.yml) ============
# 以下变量用于 standalone ocserv 部署

# 时区设置
TZ=Asia/Shanghai

# 域名 (ocserv 和监控共用，也会渲染到 ocserv.conf 的 default-domain)
DOMAIN=your.domain.com

# ocserv 对外端口（宿主机端口）
# ⚠️ 容器内部 ocserv 固定监听 443，此处仅修改宿主机映射端口
# 如需避免与其他服务冲突，可设置为如 8443
OCSERV_PORT=443

# ocserv 镜像版本
# 默认使用 Alpine minirootfs full 镜像；slim 版本可设为 kingsonho/ocserv:alpine-slim
OCSERV_IMAGE=kingsonho/ocserv:alpine

# Alpine slim 镜像禁用 utmp 时，渲染配置需同步设置为 true
OCSERV_DISABLE_UTMP=false

# 日志配置
LOG_MAX_SIZE=10m     # 单个日志文件最大大小
LOG_MAX_FILE=3       # 日志文件保留数量

# 健康检查配置
HEALTH_INTERVAL=30s   # 检查间隔
HEALTH_TIMEOUT=5s     # 超时时间
HEALTH_RETRIES=3      # 重试次数
HEALTH_START_PERIOD=15s  # 启动宽限期

# ============ 附加监控配置 (docker-compose.monitoring.yml, 可选) ============
# 仅在启用监控面板时需要以下变量

# 监控面板对外端口 (HTTPS, 宿主机端口)
MONITORING_PORT=8443

# Docker 网络名称
NETWORK_NAME=monitor-net

# 监控组件镜像版本
EXPORTER_IMAGE=kingsonho/ocserv-exporter:alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NGINX_IMAGE=nginx:alpine

# Grafana 配置
GF_ADMIN_PASSWORD=admin123    # ⚠️ 请修改默认密码！
GF_ALLOW_SIGN_UP=false        # 是否允许用户注册 (true/false)
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=30s
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=false
GF_DATAPROXY_RESPONSE_LIMIT=10485760
GRAFANA_MEM_LIMIT=512m
GRAFANA_MEMSWAP_LIMIT=512m
GRAFANA_CPUS=1.00

# Prometheus 配置
METRICS_PORT=9100             # 指标导出端口
EXPORTER_INTERVAL_SECONDS=10  # exporter 采集间隔；生产默认 10s，实时优先可设为 5s
OCCTL_TIMEOUT_SECONDS=2       # 单次 occtl 调用超时；需小于 Prometheus scrape_timeout
EXPORTER_ENABLE_SESSION_DETAIL_METRICS=false  # 是否导出 ocserv_user_* 高基数会话明细指标

# SSL 证书目录 (Nginx 反向代理使用, Let's Encrypt 默认路径)
SSL_CERT_DIR=/etc/letsencrypt
