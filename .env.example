# ============================================
# ocserv-docker environment template
# ============================================
# Usage:
# 1. Run ./scripts/prepare-ocserv-config.sh for ocserv only, or
#    ./scripts/prepare-monitoring-config.sh for the full monitoring stack.
# 2. The script opens vi .env; replace DOMAIN and set GF_ADMIN_PASSWORD before production monitoring use.
# 3. If you edit .env later, run ./scripts/render-ocserv-conf.sh again.

# Base ocserv deployment
TZ=Asia/Shanghai
DOMAIN=your.domain.com
OCSERV_PORT=443
OCSERV_VERSION=1.4.2
# Optional full image overrides for custom registries or local builds.
# OCSERV_IMAGE=kingsonho/ocserv:${OCSERV_VERSION}
# OCSERV_AUTH_IMAGE=kingsonho/ocserv-auth:${OCSERV_VERSION}
OCSERV_ENABLE_CERT_AUTH=false
OCSERV_ENABLE_COMPRESSION=false
OCSERV_MAX_CLIENTS=32
OCSERV_MEM_LIMIT=512m
OCSERV_MEMSWAP_LIMIT=512m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=15s

# Optional monitoring stack
MONITORING_PORT=8443
NETWORK_NAME=monitor-net
# EXPORTER_IMAGE=kingsonho/ocserv-exporter:${OCSERV_VERSION}
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0.1-security-01
NGINX_IMAGE=nginx:1.30.2-alpine3.23-slim
GF_ADMIN_PASSWORD=
GF_ALLOW_SIGN_UP=false
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=30s
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=false
GF_DATAPROXY_RESPONSE_LIMIT=10485760
GRAFANA_MEM_LIMIT=512m
GRAFANA_MEMSWAP_LIMIT=512m
GRAFANA_CPUS=1.00

# Exporter collection settings
METRICS_PORT=9100
EXPORTER_INTERVAL_SECONDS=10
OCCTL_TIMEOUT_SECONDS=2
EXPORTER_ENABLE_SESSION_DETAIL_METRICS=false

# Certificate auth tooling
ALLOW_EMPTY_P12_PASSWORD=true
P12_EXPORT_PASSWORD=
