# ============================================
# ocserv-docker 环境变量配置模板
# ============================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ============ 基础配置 ============
# 时区设置
TZ=Asia/Shanghai

# ============ 域名与端口 ============
# 请将 your.domain.com 替换为您的实际域名
DOMAIN=your.domain.com
# VPN服务对外端口（宿主机端口）
# ⚠️ 注意：此端口仅影响宿主机映射，容器内部固定监听 443
# 如需修改宿主机端口（避免与其他服务冲突），可设置为如 8443
OCSERV_PORT=443
# 监控面板对外端口 (HTTPS，宿主机端口)
MONITORING_PORT=8443

# ============ 镜像版本 ============
# 如需使用特定版本，请修改 :latest 为具体版本号
OCSERV_IMAGE=kingsonho/ocserv:latest
EXPORTER_IMAGE=kingsonho/ocserv-exporter:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NGINX_IMAGE=nginx:alpine

# ============ Grafana 配置 ============
# 请修改默认密码！
GF_ADMIN_PASSWORD=admin123
# 是否允许用户注册 (true/false)
GF_ALLOW_SIGN_UP=false

# ============ Prometheus 配置 ============
# 指标导出端口
METRICS_PORT=9100

# ============ 日志配置 ============
# 日志文件最大大小
LOG_MAX_SIZE=10m
# 日志文件保留数量
LOG_MAX_FILE=3

# ============ 健康检查配置 ============
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=15s

# ============ 网络配置 ============
NETWORK_NAME=monitor-net

# ============ 路径配置 ============
# SSL证书目录 (Let's Encrypt 默认路径)
SSL_CERT_DIR=/etc/letsencrypt