# ============================================
# ocserv-docker environment template
# ============================================
# Usage:
# 1. Run ./scripts/prepare-ocserv-config.sh for ocserv only.
# 2. The script opens vi .env; replace DOMAIN before production use.
# 3. If you edit .env later, run ./scripts/render-ocserv-conf.sh again.

# Base ocserv deployment
TZ=Asia/Shanghai
DOMAIN=your.domain.com

# 宿主机配置目录路径
# ocserv.conf、auth 目录等均在此目录下。容器内部路径固定为 /etc/ocserv/。
OCSERV_CONF_DIR=/etc/ocserv

# TLS 证书路径（必填）
# 宿主机上 TLS 证书链和私钥的完整路径，容器内挂载为只读。
# Let's Encrypt 示例:
#   TLS_CERT_FILE=/etc/letsencrypt/live/your.domain.com/fullchain.pem
#   TLS_KEY_FILE=/etc/letsencrypt/live/your.domain.com/privkey.pem
TLS_CERT_FILE=
TLS_KEY_FILE=
OCSERV_PORT=443
OCSERV_VERSION=1.5.0
# Optional full image override for custom registries or local builds.
# OCSERV_IMAGE=kingsonho/ocserv:${OCSERV_VERSION}
OCSERV_ENABLE_COMPRESSION=false
OCSERV_NO_UDP=false
OCSERV_MAX_CLIENTS=32
OCSERV_MEM_LIMIT=512m
OCSERV_MEMSWAP_LIMIT=512m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=15s
