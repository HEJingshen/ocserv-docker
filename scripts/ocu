#!/usr/bin/env bash
set -euo pipefail

OCPASSWD_FILE=/etc/ocserv/auth/ocpasswd

die() {
    printf '[-] %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  ocu add <username>
  ocu delete <username>

Manages ocserv password users through the running ocserv container.
EOF
}

require_one_username() {
    local action=$1
    shift
    [[ "$#" -eq 1 && -n "${1:-}" ]] || {
        usage >&2
        die "${action} requires exactly one username"
    }
}

require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is required"
}

case "${1:-}" in
    add)
        shift
        require_one_username "add" "$@"
        require_docker
        exec docker exec -it -u 0 ocserv ocpasswd -c "${OCPASSWD_FILE}" "$1"
        ;;
    delete)
        shift
        require_one_username "delete" "$@"
        require_docker
        exec docker exec -it -u 0 ocserv ocpasswd -c "${OCPASSWD_FILE}" -d "$1"
        ;;
    -h|--help|help)
        usage
        ;;
    "")
        usage >&2
        exit 2
        ;;
    *)
        usage >&2
        die "unknown command: $1"
        ;;
esac
