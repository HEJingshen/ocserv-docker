{
  "id": null,
  "uid": "ocserv-vpn-overview",
  "title": "Ocserv VPN Overview",
  "tags": ["ocserv", "vpn", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "15s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Service Status",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_up",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]},
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Down"}, "1": {"text": "Up"}}}
          ]
        }
      },
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true}
    },
    {
      "id": 2,
      "title": "Active Users",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_active_users",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 3,
      "title": "Exporter Errors (5m)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(ocserv_scrape_errors_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 4,
      "title": "Scrape Duration",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_scrape_duration_seconds",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 5,
      "title": "Traffic Rate (RX/TX)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_rx_rate_bytes_per_second",
          "interval": "15s",
          "legendFormat": "RX Rate (B/s)",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_tx_rate_bytes_per_second",
          "interval": "15s",
          "legendFormat": "TX Rate (B/s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6,
      "title": "Active Users Details",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_rx",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_tx",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_connected_seconds",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true},
            "indexByName": {"username": 0, "ip": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4},
            "renameByName": {
              "username": "User",
              "ip": "IP",
              "Value #A": "RX (Bytes)",
              "Value #B": "TX (Bytes)",
              "Value #C": "Connected (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "RX (Bytes)"},
            "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.align", "value": "right"}]
          },
          {
            "matcher": {"id": "byName", "options": "TX (Bytes)"},
            "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.align", "value": "right"}]
          },
          {
            "matcher": {"id": "byName", "options": "Connected (s)"},
            "properties": [{"id": "unit", "value": "s"}, {"id": "custom.align", "value": "right"}]
          }
        ]
      },
      "options": {"showHeader": true}
    }
  ]
}
