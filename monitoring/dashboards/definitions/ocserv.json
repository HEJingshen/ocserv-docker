{
  "id": null,
  "uid": "ocserv-vpn-monitor",
  "title": "Ocserv VPN Monitor",
  "tags": ["ocserv", "vpn"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Active Users",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_active_users",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2,
      "title": "Service Status",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]},
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Down"}, "1": {"text": "Up"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Service Uptime",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_uptime_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "blue", "value": null}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 4,
      "title": "Version Info",
      "type": "table",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_build_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value": true, "__name__": true},
            "indexByName": {"version": 0},
            "renameByName": {"version": "Version"}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "center"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Version"},
            "properties": [
              {"id": "custom.align", "value": "center"},
              {"id": "displayName", "value": "Version"}
            ]
          }
        ]
      },
      "options": {"showHeader": false}
    },
    {
      "id": 6,
      "title": "Scrape Success Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(ocserv_scrape_success_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {"steps": [{"color": "green", "value": null}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 7,
      "title": "Scrape Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_scrape_errors_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 5,
      "title": "Traffic Rate (RX/TX)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_rx_total",
          "legendFormat": "RX Total",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_tx_total",
          "legendFormat": "TX Total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8,
      "title": "Traffic Rate (bps)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 10},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_rx_total / 15",
          "legendFormat": "RX Rate (B/s)",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_tx_total / 15",
          "legendFormat": "TX Rate (B/s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9,
      "title": "Per User Traffic",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 10},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_rx",
          "legendFormat": "{{username}} (RX)",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_tx",
          "legendFormat": "{{username}} (TX)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 5}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}}
    },
    {
      "id": 10,
      "title": "Active Users Details",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_rx",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_bytes_tx",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_connected_seconds",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true},
            "indexByName": {"username": 0, "ip": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4},
            "renameByName": {
              "username": "User",
              "ip": "IP",
              "Value #A": "RX (Bytes)",
              "Value #B": "TX (Bytes)",
              "Value #C": "Connected (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "RX (Bytes)"},
            "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.align", "value": "right"}]
          },
          {
            "matcher": {"id": "byName", "options": "TX (Bytes)"},
            "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.align", "value": "right"}]
          },
          {
            "matcher": {"id": "byName", "options": "Connected (s)"},
            "properties": [{"id": "unit", "value": "s"}, {"id": "custom.align", "value": "right"}]
          }
        ]
      },
      "options": {"showHeader": true}
    },
    {
      "id": 11,
      "title": "User Traffic Ranking (Top 10)",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, ocserv_user_bytes_rx + ocserv_user_bytes_tx)",
          "legendFormat": "{{username}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {"steps": [{"color": "blue", "value": null}]}
        }
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal"}
    },
    {
      "id": 12,
      "title": "Connection Duration",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_connected_seconds",
          "legendFormat": "{{username}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal"}
    }
  ]
}