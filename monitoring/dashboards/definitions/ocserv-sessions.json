{
  "id": null,
  "uid": "ocserv-vpn-sessions",
  "title": "Ocserv VPN Sessions",
  "tags": [
    "ocserv",
    "vpn"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Active Session Details",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocserv_user_bytes_rx",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocserv_user_bytes_tx",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocserv_user_connected_seconds",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "username 1": true,
              "username 2": true,
              "ip 1": true,
              "ip 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "vpn_ip 1": true,
              "vpn_ip 2": true,
              "device": true,
              "device 1": true,
              "device 2": true
            },
            "indexByName": {
              "username": 0,
              "username 3": 0,
              "session_id": 1,
              "ip": 2,
              "ip 3": 2,
              "vpn_ip": 3,
              "vpn_ip 3": 3,
              "Value #C": 4,
              "Value #A": 5,
              "Value #B": 6
            },
            "renameByName": {
              "username": "Username",
              "username 3": "Username",
              "session_id": "Session ID",
              "ip": "Client IP",
              "ip 3": "Client IP",
              "vpn_ip": "VPN IP",
              "vpn_ip 3": "VPN IP",
              "Value #A": "Received",
              "Value #B": "Transmitted",
              "Value #C": "Connected Time"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Username": 0,
              "Session ID": 1,
              "Client IP": 2,
              "VPN IP": 3,
              "Connected Time": 4,
              "Received": 5,
              "Transmitted": 6
            },
            "renameByName": {
              "Username": "Username",
              "Session ID": "Session ID",
              "Client IP": "Client IP",
              "VPN IP": "VPN IP",
              "Connected Time": "Connected Time",
              "Received": "Received",
              "Transmitted": "Transmitted"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Received"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Transmitted"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Connected Time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Per Session Traffic (Top 10)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(ocserv_user_bytes_rx + ocserv_user_bytes_tx) and on(username, session_id, ip, vpn_ip, device) topk(10, (ocserv_user_bytes_rx @ end() + ocserv_user_bytes_tx @ end()) and on(username, session_id, ip, vpn_ip, device) ocserv_user_connected_seconds @ end())",
          "interval": "30s",
          "legendFormat": "{{username}} #{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 3,
      "title": "Session Traffic Ranking (Top 10)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, (ocserv_user_bytes_rx + ocserv_user_bytes_tx) and on(username, session_id, ip, vpn_ip, device) ocserv_user_connected_seconds @ end())",
          "instant": true,
          "legendFormat": "{{username}} #{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "title": "Connection Duration",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocserv_user_connected_seconds and on(username, session_id, ip, vpn_ip, device) ocserv_user_connected_seconds @ end()",
          "instant": true,
          "legendFormat": "{{username}} #{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "title": "Per Session Rate (Top 10)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(ocserv_user_bytes_rx_rate_bytes_per_second + ocserv_user_bytes_tx_rate_bytes_per_second) and on(username, session_id, ip, vpn_ip, device) topk(10, (ocserv_user_bytes_rx_rate_bytes_per_second @ end() + ocserv_user_bytes_tx_rate_bytes_per_second @ end()) and on(username, session_id, ip, vpn_ip, device) ocserv_user_connected_seconds @ end())",
          "interval": "10s",
          "legendFormat": "{{username}} #{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
