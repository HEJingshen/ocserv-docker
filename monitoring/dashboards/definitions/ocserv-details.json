{
  "id": null,
  "uid": "ocserv-vpn-details",
  "title": "Ocserv VPN Details",
  "tags": ["ocserv", "vpn", "details"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Service Uptime",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_uptime_seconds",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "blue", "value": null}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 2,
      "title": "Version Info",
      "type": "table",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_build_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value": true, "__name__": true},
            "indexByName": {"version": 0},
            "renameByName": {"version": "Version"}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "center"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Version"},
            "properties": [
              {"id": "custom.align", "value": "center"},
              {"id": "displayName", "value": "Version"}
            ]
          }
        ]
      },
      "options": {"showHeader": false}
    },
    {
      "id": 3,
      "title": "Scrape Success Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(ocserv_scrape_success_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {"steps": [{"color": "green", "value": null}]},
          "mappings": []
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 4,
      "title": "Traffic Total (RX/TX)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_rx_total",
          "interval": "30s",
          "legendFormat": "RX Total",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_bytes_tx_total",
          "interval": "30s",
          "legendFormat": "TX Total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5,
      "title": "Per User Traffic (Top 10)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 11},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, ocserv_user_bytes_rx)",
          "interval": "30s",
          "legendFormat": "{{username}} (RX)",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, ocserv_user_bytes_tx)",
          "interval": "30s",
          "legendFormat": "{{username}} (TX)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 5}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}}
    },
    {
      "id": 6,
      "title": "User Traffic Ranking (Top 10)",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 18},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, ocserv_user_bytes_rx + ocserv_user_bytes_tx)",
          "legendFormat": "{{username}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {"steps": [{"color": "blue", "value": null}]}
        }
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal"}
    },
    {
      "id": 7,
      "title": "Connection Duration",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 18},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ocserv_user_connected_seconds",
          "legendFormat": "{{username}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal"}
    }
  ]
}
