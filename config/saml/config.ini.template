# SAML 2.0 Service Provider Configuration
# Copy this file to config.ini and customize for your IdP integration.
#
# Required fields:
#   - sp-metadata-file: Service Provider metadata XML file
#   - sp-keyfile: Service Provider private key (PEM format)
#   - sp-cert: Service Provider certificate (PEM format)
#   - idp-metadata-file: Identity Provider metadata XML file
#
# See docs/saml-auth.md for detailed setup instructions.

# Service Provider (SP) metadata file path
# This file contains the SP's SAML metadata describing the service
sp-metadata-file = /etc/ocserv/saml/sp-metadata.xml

# Service Provider private key
# PEM format private key for signing SAML requests
sp-keyfile = /etc/ocserv/saml/sp-key.pem

# Service Provider certificate
# PEM format certificate corresponding to the private key
sp-cert = /etc/ocserv/saml/sp-cert.pem

# Identity Provider (IdP) metadata file path
# Download from your IdP (Okta, Azure AD, Keycloak, etc.)
idp-metadata-file = /etc/ocserv/saml/idp-metadata.xml

# Identity Provider certificate (optional)
# Some IdPs require explicit certificate for signature validation
idp-cert = /etc/ocserv/saml/idp-cert.pem

# Clock skew tolerance in seconds (optional, default 60)
# Adjust this value if your IdP has larger clock differences
# This affects both Conditions and SubjectConfirmationData time validation
clock-skew-tolerance = 60