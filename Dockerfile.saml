# syntax=docker/dockerfile:1.7
#
# Dockerfile for ocserv with SAML 2.0 authentication support
# Uses lasso 2.9.0 (includes security fixes for CVE-2025-47151, CVE-2025-46404, etc.)
#

ARG ALPINE_IMAGE=alpine:3.23.4

# Stage 1: Build liblasso 2.9.0 for SAML2 support
FROM ${ALPINE_IMAGE} AS lasso-builder

ARG APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine

COPY scripts/configure-alpine-repositories.sh /usr/local/bin/configure-alpine-repositories

RUN set -eux; \
    chmod +x /usr/local/bin/configure-alpine-repositories; \
    configure-alpine-repositories "${APK_MIRROR}"

# Install lasso build dependencies
RUN --mount=type=cache,target=/var/cache/apk \
    apk add --update-cache \
        build-base pkgconfig glib-dev libxml2-dev libxslt-dev \
        xmlsec-dev openssl-dev gettext-dev zlib-dev apr-dev \
        autoconf automake libtool

# Copy lasso 2.9.0 source (includes CVE-2025-47151 security fix)
COPY src/lasso-2.9.0.tar.gz /tmp/lasso.tar.gz

# Build lasso. The 2.9.0 source already includes the downstream python-six,
# GCC 15, and xmlsec 1.3 compatibility fixes needed by this image.
RUN set -eux; \
    cd /tmp && tar xzf lasso.tar.gz && cd lasso-2.9.0; \
    touch aclocal.m4 Makefile.in configure config.h.in; \
    ./configure --prefix=/usr --disable-java --disable-perl --disable-php5 --disable-php7 --disable-gtk-doc --with-default-sign-algo=rsa-sha256 CFLAGS="-DXMLSEC_CRYPTO=openssl"; \
    make -j$(nproc) && make DESTDIR=/out install; \
    rm -rf /tmp/lasso-* /tmp/*.patch

# Stage 2: Build ocserv with SAML support
FROM ${ALPINE_IMAGE} AS builder

ARG OCSERV_VERSION
ARG APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine

COPY scripts/configure-alpine-repositories.sh /usr/local/bin/configure-alpine-repositories

RUN set -eux; \
    chmod +x /usr/local/bin/configure-alpine-repositories; \
    configure-alpine-repositories "${APK_MIRROR}"

# Install ocserv build dependencies (including SAML dependencies)
RUN --mount=type=cache,target=/var/cache/apk \
    set -eux; \
    apk add --update-cache \
        build-base \
        ca-certificates \
        gawk \
        gnutls-dev \
        gperf \
        libev-dev \
        libnl3-dev \
        linux-headers \
        lz4-dev \
        meson \
        nettle-dev \
        ninja \
        pkgconf \
        protobuf-c-dev \
        protobuf-c-compiler \
        readline-dev \
        xz; \
    if ! command -v ipcalc >/dev/null 2>&1; then \
        printf '#!/bin/sh\nexec busybox ipcalc "$@"\n' > /usr/local/bin/ipcalc; \
        chmod +x /usr/local/bin/ipcalc; \
    fi; \
    apk add --update-cache \
        krb5-dev \
        libtasn1-dev \
        linux-pam-dev \
        talloc-dev; \
    apk add --update-cache oath-toolkit-dev || echo "WARNING: oath-toolkit-dev unavailable; OTP/liboath will remain auto-detected"; \
    apk add --update-cache radcli-dev || echo "WARNING: radcli-dev unavailable; RADIUS will remain auto-detected"; \
    apk add --update-cache libxcrypt-dev || true; \
    # SAML2 dependencies
    apk add --update-cache glib-dev libxml2-dev xmlsec-dev apr-dev

# Copy lasso artifacts and SAML patches
COPY --from=lasso-builder /out/ /lasso/
COPY src/patches/vpn.h.patch /patches/vpn.h.patch
COPY src/patches/common-config.h.patch /patches/common-config.h.patch
COPY src/patches/meson_options.txt.patch /patches/meson_options.txt.patch
COPY src/patches/meson.build.patch /patches/meson.build.patch
COPY src/patches/src-meson.build.patch /patches/src-meson.build.patch
COPY src/patches/config.c.patch /patches/config.c.patch
COPY src/patches/worker-auth.c.patch /patches/worker-auth.c.patch
COPY src/patches/worker.h.patch /patches/worker.h.patch
COPY src/patches/worker-http.c.patch /patches/worker-http.c.patch
COPY src/patches/worker-http-handlers.c.patch /patches/worker-http-handlers.c.patch
COPY src/saml/saml.c /saml/saml.c
COPY src/saml/saml.h /saml/saml.h
COPY src/saml/lasso_compat.h /saml/lasso_compat.h

COPY src/ocserv-${OCSERV_VERSION}.tar.xz /tmp/ocserv.tar.xz

# Build ocserv with SAML patches
RUN set -eux; \
    cd /tmp && tar -xf ocserv.tar.xz && cd ocserv-${OCSERV_VERSION}; \
    # Apply SAML2 patches
    patch -p1 < /patches/vpn.h.patch; \
    patch -p1 < /patches/common-config.h.patch; \
    patch -p1 < /patches/meson_options.txt.patch; \
    patch -p1 < /patches/meson.build.patch; \
    patch -p1 < /patches/src-meson.build.patch; \
    patch -p1 < /patches/config.c.patch; \
    patch -p1 < /patches/worker.h.patch; \
    patch -p1 < /patches/worker-auth.c.patch; \
    patch -p1 < /patches/worker-http.c.patch; \
    patch -p1 < /patches/worker-http-handlers.c.patch; \
    cp /saml/saml.c src/auth/ && cp /saml/saml.h src/auth/ && cp /saml/lasso_compat.h src/auth/; \
    cp -a /lasso/* /; \
    # Build with SAML enabled
    meson setup build \
        --prefix /usr \
        --buildtype release \
        -Doidc-auth=disabled \
        -Dfirewall-script=iptables \
        -Dlocal-llhttp=true \
        -Dlocal-pcl=true \
        -Dpam=enabled \
        -Dradius=auto \
        -Dgssapi=enabled \
        -Dliboath=auto \
        -Dsystemd=disabled \
        -Dutmp=auto \
        -Dlibwrap=auto \
        -Dseccomp=disabled \
        -Dlz4=enabled \
        -Dlibnl=enabled \
        -Dsaml-auth=enabled; \
    ninja -C build && DESTDIR=/out ninja -C build install; \
    # Copy lasso runtime libraries
    mkdir -p /out/usr/lib; \
    cp -a /usr/lib/liblasso.so* /out/usr/lib/ || true; \
    rm -rf /tmp/ocserv-* /patches /saml /lasso

# Stage 3: Runtime image with SAML support
FROM ${ALPINE_IMAGE}

ARG OCSERV_VERSION
ARG ALPINE_IMAGE=alpine:3.23.4
ARG ALPINE_VERSION=3.23.4
ARG BUILD_DATE
ARG APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine

LABEL maintainer="72605370+GentleKingson@users.noreply.github.com" \
      org.opencontainers.image.title="ocserv-alpine-saml" \
      org.opencontainers.image.description="OpenConnect VPN Server Alpine image with SAML 2.0 authentication support" \
      org.opencontainers.image.version="${OCSERV_VERSION}-saml" \
      org.opencontainers.image.alpine-version="${ALPINE_VERSION}" \
      org.opencontainers.image.base.name="${ALPINE_IMAGE}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/GentleKingson/ocserv-docker" \
      org.opencontainers.image.auth.features="SAML2.0,PAM,GSSAPI,RADIUS,OTP"

COPY scripts/configure-alpine-repositories.sh /usr/local/bin/configure-alpine-repositories

RUN set -eux; \
    chmod +x /usr/local/bin/configure-alpine-repositories; \
    configure-alpine-repositories "${APK_MIRROR}"

COPY --from=builder /out/ /

RUN --mount=type=cache,target=/var/cache/apk \
    set -eux; \
    apk add --update-cache \
        ca-certificates \
        grep \
        iproute2 \
        iptables \
        pax-utils \
        sed \
        tzdata; \
    runDeps="$(scanelf --needed --nobanner --format '%n#p' \
            /usr/bin/occtl /usr/bin/ocpasswd /usr/sbin/ocserv /usr/sbin/ocserv-worker \
        | tr ',' '\n' \
        | sort -u \
        | awk 'NF { print "so:" $1 }' \
        | grep -v 'liblasso' || true)"; \
    apk add --update-cache --virtual .ocserv-rundeps ${runDeps}; \
    # Install lasso runtime dependencies for SAML support
    apk add --update-cache libxml2 libxslt xmlsec glib apr; \
    apk add --update-cache s6-overlay; \
    [ -x /init ]

ENV PATH="/command:${PATH}"

RUN set -eux; \
    mkdir -p /etc/ocserv /run/ocserv /var/log/ocserv \
             /etc/s6-overlay/s6-rc.d/ocserv-init \
             /etc/s6-overlay/s6-rc.d/ocserv \
             /etc/s6-overlay/s6-rc.d/ocserv/dependencies.d \
             /etc/s6-overlay/s6-rc.d/user/contents.d; \
    echo "oneshot" > /etc/s6-overlay/s6-rc.d/ocserv-init/type; \
    echo "longrun" > /etc/s6-overlay/s6-rc.d/ocserv/type; \
    ln -s ../ocserv-init /etc/s6-overlay/s6-rc.d/ocserv/dependencies.d/; \
    ln -s ../ocserv-init /etc/s6-overlay/s6-rc.d/user/contents.d/; \
    ln -s ../ocserv /etc/s6-overlay/s6-rc.d/user/contents.d/

COPY docker/ocserv/s6-init.sh /etc/ocserv/s6-init.sh

RUN set -eux; \
    chmod +x /etc/ocserv/s6-init.sh; \
    printf '#!/command/execlineb -P\n/etc/ocserv/s6-init.sh\n' \
        > /etc/s6-overlay/s6-rc.d/ocserv-init/up; \
    chmod +x /etc/s6-overlay/s6-rc.d/ocserv-init/up; \
    printf '#!/bin/sh\nexec ocserv -c /etc/ocserv/ocserv.conf -f\n' \
        > /etc/s6-overlay/s6-rc.d/ocserv/run; \
    chmod +x /etc/s6-overlay/s6-rc.d/ocserv/run

EXPOSE 443/tcp 443/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ss -tln | grep -q ':443' || exit 1

ENTRYPOINT ["/init"]
